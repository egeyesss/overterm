{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OverTerm",
  "version": "0.2.0",
  "identifier": "io.github.egeyesilyurt.overterm",
  "build": {
    "beforeDevCommand": "npm run dev --prefix app/ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix app/ui",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OverTerm",
        "width": 660,
        "height": 620,
        "minWidth": 400,
        "minHeight": 44,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
